FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# true = local SQLite (dev). false = MySQL (server)
USE_LOCAL_SQLITE=true

PORTAL_DOMAIN=agribooks.udottechnologies.com
UPDATE_MANIFEST_URL=https://agribooks.udottechnologies.com/updates/version.json

# Portal MySQL (companies, portal users, synced ledgers)
MYSQL_DATABASE_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE

# Optional — seed defaults (seed_super_admin.py)
SUPER_ADMIN_USERNAME=U. Technologies
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=U. Technologies
SUPER_ADMIN_EMAIL=admin@udottechnologies.com

