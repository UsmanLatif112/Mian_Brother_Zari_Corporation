# ============================================================
# ONLINE ERP (hosted browser app — MySQL + agency multi-tenant)
# Copy this file to .env on the host and fill secrets.
# ============================================================

APP_MODE=online
FLASK_ENV=production
OFFLINE_FIRST=false
DATABASE_MODE=production
SECRET_KEY=CHANGE-ME-LONG-RANDOM-STRING

# Main MySQL (shops sync here; online app reads/writes here)
MYSQL_DATABASE_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Online: only Super Admin + fully registered users (no public trial signup)
ONLINE_REQUIRE_REGISTERED=true

# No desktop-style push cron on the server
SYNC_AUTO_ENABLED=false
AUTO_BACKUP_ENABLED=false

# Optional packaging / logos path writable on host
# BACKUP_DIR=backups
# LOG_LEVEL=INFO
