FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-long-random-string

# Offline-first: SQLite locally; cloud backup via Google Drive
OFFLINE_FIRST=true
DATABASE_MODE=sqlite
SQLITE_DATABASE_URI=sqlite:///mbzc_erp.db

# Google Drive cloud backup (see setup guide in app)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Optional: override OAuth callback (default uses APP_BASE_URL or current host)
# GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:5000/sync-backup/google/callback
GOOGLE_DRIVE_AUTO_UPLOAD=true
GOOGLE_DRIVE_RETENTION=10
GOOGLE_DRIVE_QUEUE_INTERVAL_MINUTES=5

# Hourly SQLite backup cron (uploads to Drive when connected)
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=1
BACKUP_UI_LIMIT=10
BACKUP_DIR=backups
LOG_LEVEL=INFO

# Desktop app port (used for Google OAuth redirect on localhost)
DESKTOP_PORT=5000

# Legacy MySQL: registry uses MYSQL_DATABASE_URI; shop data push uses SYNC target
# SUPER ADMIN / license registry (production)
# MYSQL_DATABASE_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/PRODUCTION_DB
# Shop business cloud (test)
# MYSQL_TEST_DATABASE_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/TEST_DB
# SYNC_MYSQL_TARGET=test
# SYNC_AUTO_ENABLED=true
# SYNC_INTERVAL_MINUTES=15
# SYNC_LOG_KEEP=5
# SYNC_PUSH_BATCH_SIZE=200
