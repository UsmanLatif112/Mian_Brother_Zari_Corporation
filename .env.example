FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-long-random-string

# Offline-first: SQLite locally; push to MySQL from Sync page
OFFLINE_FIRST=true
DATABASE_MODE=sqlite
SQLITE_DATABASE_URI=sqlite:///mbzc_erp.db
SYNC_MYSQL_TARGET=production

MYSQL_HOST=your-host
MYSQL_PORT=3306
MYSQL_DATABASE_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
MYSQL_TEST_DATABASE_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_TEST

SYNC_AUTO_ENABLED=true
SYNC_INTERVAL_MINUTES=15
# Fast fail when offline (seconds); does not block sales/inventory UI
SYNC_MYSQL_CONNECT_TIMEOUT=2
SYNC_MYSQL_CACHE_SECONDS=45
# Hourly SQLite backup cron (keeps all files; app lists only last BACKUP_UI_LIMIT)
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=1
BACKUP_UI_LIMIT=10
BACKUP_DIR=backups
LOG_LEVEL=INFO
